PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/interviewly
JWT_WEB_TOKEN=replace-this-with-a-long-random-secret
GEMINI_API_KEY=your-google-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
HEYGEN_API_KEY=
# Sandbox uses the free Wayne avatar for short tests. Set sandbox to false and
# provide both production avatar IDs (credits apply).
LIVEAVATAR_SANDBOX=true
LIVEAVATAR_AVATAR_ID_GIRL=
LIVEAVATAR_AVATAR_ID_BOY=
# Optional legacy fallback when a gender-specific avatar ID is not configured.
LIVEAVATAR_AVATAR_ID=
RESENDEMAIL_API_KEY=your-resend-api-key
EMAIL_FROM="InterviewPro <no-reply@shubhamsah.com.np>"
# Optional. When set, Redis backs shared auth rate limits across API instances.
REDIS_URI=

# SMTP is optional if you prefer it over Resend.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
